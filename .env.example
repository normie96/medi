# GEMINI_API_KEY: Required for Gemini AI API calls (prescription structuring, image analysis, simplified language).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# DATABASE_URL: PostgreSQL database connection string for Prisma.
# Example for local development: postgresql://postgres:postgres@localhost:5432/medilens?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medilens?schema=public"

# JWT_SECRET: Secret key for signing JSON Web Tokens for authentication.
JWT_SECRET="medilens_secure_jwt_token_secret_key_2026_change_in_production"

# PORT: Server port (defaults to 3000 in container environment)
PORT=3000

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV="development"
